<html>

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  <meta property="og:site_name" content="{{siteName}}" />
  <meta property="og:title" content="{{title}}" />
  <meta property="og:description" content="{{description}}" />
  {{{favicon}}}
  <style type="text/css">
    @import url('https://api.fonts.coollabs.io/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap');

    * {
      font-family: "Atkinson Hyperlegible", sans-serif;
    }

    body {
      font-size: 18px;
      background-color: #F5F5F5;
      color: #444;
    }

    div.banner {
      {{!-- remove default body styles --}}
      margin: -8px -8px -20px -8px;
      text-align: center;
      font-size: 16px;
      {{!-- Tailwind yellow-300 --}}
      background-color: oklch(85.2% 0.199 91.936);
      padding: 5px 10vw;
    }

    div.content {
      padding: 0 10px;
      margin: 40px auto;
      max-width: 650px;
      line-height: 1.6;
    }

    h1,
    h2,
    h3 {
      line-height: 1.2;
    }

    div.title {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    div.title h1, span {
      font-size: 2.5em;
      margin-top: 0;
      margin-bottom: 0;
    }

    div.title h1 {
      width: 85%;
      word-wrap: break-word;
    }


    code {
      border-radius: 4px;
      border: 1px solid rgb(232, 235, 237);
      background: rgb(244, 247, 250);
      padding: 3px 4px;
      color: rgb(3, 47, 98);
      font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, Courier, monospace;
      font-size: 80%;
    }

    @media (prefers-color-scheme: dark) {
      body {
        color: #e2e8f0;
        background-color: #141414;
      }

      div.banner {
        {{!-- Tailwind yellow-600 --}}
        background-color: #d08700;
      }

      a {
        color: #3b82f6;
      }

      a:visited {
        color: #a855f7
      }

      code {
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgb(17, 19, 25);
        padding: 3px 4px;
        color: rgb(206, 145, 120);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace font-size: 80%;
      }
    }
  </style>
  <script defer src="https://umami.cowsay.io/script.js" data-website-id="64248185-bcc9-49a6-a2cd-a4e8d6ea1aa1"></script>
  <link rel="me" href="https://unhinged.dog/@woof" />
</head>

<body>
  {{#if failover}}
    <div class="banner">
      <p>You&apos;re on a cached version of this website, as my homelab server has gone down. It should be back soon!
        <br />
        This copy of the website was generated on {{failover/generatedAt}}, so some content might not be up-to-date and some links might not work.
      </p>
    </div>
  {{/if}}

  <div class="content">
    <div class="title">
      <h1>{{title}}</h1>
      {{#if emoji}}
        <span>{{emoji}}</span>
      {{/if}}
    </div>


    {{{html}}}

    <hr />

    {{#if renderTime}}
      <p>This page was rendered{{#if useSampleData}} using sample data{{/if}} in {{renderTime}}ms from
        {{#if commit}}<code>{{commit}}</code>.
        {{else}}
        an unknown commit.
        {{/if}}
      <br />
    {{/if}}

    {{#if updatedAt}}
      This page was last updated at {{updatedAt}}.
    {{/if}}
    </p>
  </div>
</body>

</html>
